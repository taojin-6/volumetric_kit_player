#
# measure: run a measurement of the player and bring its logs home, from the
# Mac, which only orchestrates (README.md, "Measure"; DECISIONS.md).
#
#   measure [--dry-run] lab <ref> [--passes P] [--frames N] [--timing T,...]
#       On the lab's RTX 4090, in its own clone of the player under LAB_ROOT
#       (one run at a time): check out <ref>, build vp_probe Release with no
#       desktop app (so no GLFW) under uvrun, run it on rafa2.vrst under
#       `uvrun --time` once per timing, and copy the logs home.
#   measure [--dry-run] iphone|ipad <ref> [--passes P] [--frames N]
#                                         [--timing T,...]
#       Build the signed Release app at <ref> on the Mac, install it on the
#       device, copy rafa2.vrst into its Documents if missing, then once per
#       timing launch it with the measure arguments (the device must be
#       unlocked), wait for its log, and copy it home. A launch that logs
#       nothing stops the run with the app's reason (a .failed file), or when
#       the app is gone. It starts an app on the owner's device: run it only
#       with the owner's go-ahead.
#   measure summarize <log.csv>...
#       The logs as markdown (summarize.py): two give a before/after diff.
#
# Defaults: 2 passes, the first a warm-up that the summary leaves out; every
# frame of them; timing off, then all. <ref> is a branch, a tag, a commit, or
# pr/<n>. --dry-run prints the commands and runs none. Settings come from the
# environment, after ${MEASURE_CONFIG:-~/.config/volumetric_kit/measure.env}
# if it exists:
#   VP_DEVELOPMENT_TEAM  the Apple team that signs the app (phones; required)
#   MEASURE_DEVICE       a devicectl device; default the first iPhone or iPad
#   MEASURE_AGENT        uvrun's agent name on the lab (default measure)
#   MEASURE_OUT          where logs go (default ~/ws/volumetric_kit/measurements)
#   LAB_HOST, LAB_ROOT, LAB_STREAM, PLAYER_URL, MAC_REPO, MAC_STREAM,
#   MoltenVK_ROOT, VP_BUNDLE_ID  as defaulted below.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config="${MEASURE_CONFIG:-$HOME/.config/volumetric_kit/measure.env}"
if [ -f "$config" ]; then
  # shellcheck disable=SC1090
  . "$config"
fi
LAB_HOST="${LAB_HOST:-taojin@taojin-desktop.arena.andrew.cmu.edu}"
LAB_ROOT="${LAB_ROOT:-/home/taojin/claude_scratch/dataflow/measure}"
LAB_UVRUN="${LAB_UVRUN:-/home/taojin/claude_scratch/dataflow/bin/uvrun}"
LAB_STREAM="${LAB_STREAM:-/home/taojin/ws/volumetric_kit/streams/rafa2.vrst}"
PLAYER_URL="${PLAYER_URL:-https://github.com/taojin-6/volumetric_kit_player.git}"
MAC_REPO="${MAC_REPO:-$HOME/ws/volumetric_kit/volumetric_kit_player}"
MAC_STREAM="${MAC_STREAM:-$HOME/ws/volumetric_kit/streams/rafa2.vrst}"
MoltenVK_ROOT="${MoltenVK_ROOT:-$HOME/ws/volumetric_kit/third_party/MoltenVK_ios_v1.4.2/MoltenVK}"
VP_BUNDLE_ID="${VP_BUNDLE_ID:-io.taojin.volumetrickit.player}"
MEASURE_AGENT="${MEASURE_AGENT:-measure}"
MEASURE_OUT="${MEASURE_OUT:-$HOME/ws/volumetric_kit/measurements}"

dry=0
usage() {
  sed -n '8,35p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}
fail() {
  echo "measure: $*" >&2
  exit 1
}
# Run a command, or with --dry-run print it.
run() {
  if [ "$dry" = 1 ]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

# The commit <ref> names in the checkout at $1, once it is fetched: a PR's
# head alone for pr/<n>, else origin's branches. The lab runs it too.
commit_of() {
  local repo="$1" ref="$2"
  case "$ref" in
    pr/*)
      git -C "$repo" fetch --quiet origin \
        "+refs/pull/${ref#pr/}/head:refs/remotes/origin/$ref"
      ;;
    *) git -C "$repo" fetch --quiet origin ;;
  esac
  git -C "$repo" rev-parse --verify --quiet "origin/$ref^{commit}" ||
    git -C "$repo" rev-parse --verify --quiet "$ref^{commit}"
}

summarize() {
  [ "$#" -ge 1 ] || usage
  python3 -I "$here/summarize.py" "$@"
}

# The options both modes take, into passes, frames and timings.
options() {
  passes=2
  frames=""
  timings="off,all"
  while [ "$#" -gt 0 ]; do
    [ "$#" -ge 2 ] || usage
    case "$1" in
      --passes) passes="$2" ;;
      --frames) frames="$2" ;;
      --timing) timings="$2" ;;
      *) usage ;;
    esac
    shift 2
  done
}

# The lab: one script over ssh, so the lab does the work and the Mac waits.
lab() {
  local ref="$1"
  shift
  local passes frames timings
  options "$@"
  local stamp out
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$MEASURE_OUT/$(date +%Y-%m-%d)"
  local script
  script="$(cat <<EOF
set -euo pipefail
exec 3>&1 1>&2  # only the paths of the logs go to stdout, to the Mac
# (no quote marks in this script: bash 3.2 misparses them in a heredoc in \$())
root=$(printf %q "$LAB_ROOT"); url=$(printf %q "$PLAYER_URL")
uvrun=$(printf %q "$LAB_UVRUN"); agent=$(printf %q "$MEASURE_AGENT")
stream=$(printf %q "$LAB_STREAM"); ref=$(printf %q "$ref")
$(declare -f commit_of)
mkdir -p "\$root/out"
# One run at a time: the clone, the build and the logs are under the root.
exec 4>"\$root/run.lock"
if ! flock -n 4; then
  echo "measure: another run holds \$root/run.lock; waiting"
  flock 4
fi
repo="\$root/player"
[ -d "\$repo/.git" ] || git clone --quiet "\$url" "\$repo"
sha=\$(commit_of "\$repo" "\$ref") || { echo "measure: no commit \$ref"; exit 1; }
git -C "\$repo" checkout --quiet --detach "\$sha"
"\$uvrun" "\$agent" -- cmake -S "\$repo" -B "\$root/build" -G "Unix Makefiles" \
  -DCMAKE_BUILD_TYPE=Release -DVP_DESKTOP_APP=OFF
"\$uvrun" "\$agent" -- cmake --build "\$root/build" --parallel 8 \
  --target vp_probe
for timing in \$(echo $(printf %q "$timings") | tr , ' '); do
  csv="\$root/out/$stamp-\${sha:0:7}-lab-\$timing.csv"
  "\$uvrun" --time "\$agent" -- "\$root/build/tests/vp_probe" --worker \
    --file "\$stream" --passes $passes ${frames:+--frames $frames} \
    --timing "\$timing" --csv "\$csv"
  echo "\$csv" >&3  # in the order run, which the diff keeps
done
EOF
)"
  if [ "$dry" = 1 ]; then
    echo "+ ssh $LAB_HOST bash -s <<'EOF'"
    echo "$script"
    echo "EOF"
    run mkdir -p "$out"
    run scp "${LAB_HOST}:$LAB_ROOT/out/$stamp-*.csv" "$out/"
    return
  fi
  local logs
  logs="$(ssh -o BatchMode=yes "$LAB_HOST" bash -s <<<"$script")"
  mkdir -p "$out"
  local fetched=()
  for log in $logs; do
    scp -q "${LAB_HOST}:$log" "$out/"
    fetched+=("$out/$(basename "$log")")
  done
  summarize "${fetched[@]}" | tee "$out/$stamp-lab.md"
}

# A devicectl call's JSON output, into $1.
devicectl_json() {
  local file="$1"
  shift
  xcrun devicectl "$@" --quiet --json-output "$file" >/dev/null
}

# Every string in a devicectl JSON file at $1 that ends with $2, one a line:
# the file names in a listing, or the processes' executables, whatever its
# layout.
json_strings() {
  python3 -I - "$1" "$2" <<'PY'
import json, sys
def walk(value):
    if isinstance(value, dict):
        for item in value.values():
            yield from walk(item)
    elif isinstance(value, list):
        for item in value:
            yield from walk(item)
    elif isinstance(value, str):
        yield value
with open(sys.argv[1], encoding="utf-8") as file:
    for text in walk(json.load(file)):
        if text.endswith(sys.argv[2]):
            print(text)
PY
}

# The device: $MEASURE_DEVICE, or the first of kind $1 (iPhone, iPad).
pick_device() {
  if [ -n "${MEASURE_DEVICE:-}" ]; then
    echo "$MEASURE_DEVICE"
    return
  fi
  if [ "$dry" = 1 ]; then
    echo "<first $1>"
    return
  fi
  local list
  list="$(mktemp)"
  devicectl_json "$list" list devices
  python3 -I - "$list" "$1" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as file:
    devices = json.load(file).get("result", {}).get("devices", [])
for device in devices:
    if device.get("hardwareProperties", {}).get("deviceType") == sys.argv[2]:
        print(device["identifier"])
        break
else:
    sys.exit(f"measure: no {sys.argv[2]} in devicectl's list")
PY
  rm -f "$list"
}

# The names in the app's Documents/measure on $device, one a line, into the
# file $1; false when devicectl cannot list it (none yet).
measure_files() {
  devicectl_json "$listing" device info files --device "$device" \
    --domain-type appDataContainer --domain-identifier "$VP_BUNDLE_ID" \
    --subdirectory Documents/measure &&
    { json_strings "$listing" .csv; json_strings "$listing" .failed; } >"$1"
}

# A file of the app's Documents/measure on $device, $1, copied to $2.
copy_measure_file() {
  xcrun devicectl device copy from --device "$device" \
    --domain-type appDataContainer --domain-identifier "$VP_BUNDLE_ID" \
    --source "Documents/measure/$(basename "$1")" --destination "$2"
}

# One launch at timing $1 on $device: its log, copied into $out, its path on
# stdout. The app renames its log from .part once it is whole, and writes a
# .failed with its reason instead when it cannot log.
launch() {
  local timing="$1"
  local before="$tmp_before" now="$tmp_now"
  measure_files "$before" || : >"$before"
  echo "measure: launching the player on $kind $device, timing $timing:" \
    "keep it unlocked" >&2
  xcrun devicectl device process launch --device "$device" \
    --terminate-existing "$VP_BUNDLE_ID" -- --measure "$name" \
    --passes "$passes" ${frames:+--frames "$frames"} --timing "$timing" \
    >/dev/null
  local deadline=$((SECONDS + 1200)) seen=0 file=""
  while [ -z "$file" ]; do
    [ "$SECONDS" -lt "$deadline" ] || fail "no log after 20 min"
    sleep 5
    measure_files "$now" || continue
    file="$(grep -vxF -f "$before" "$now" | head -n 1 || true)"
    if [ -z "$file" ] && devicectl_json "$listing" device info processes \
      --device "$device"; then
      # Gone, once seen, with nothing written: it crashed or was stopped.
      if [ -n "$(json_strings "$listing" \
        volumetric_kit_player.app/volumetric_kit_player)" ]; then
        seen=1
      elif [ "$seen" = 1 ]; then
        measure_files "$now" || :
        file="$(grep -vxF -f "$before" "$now" | head -n 1 || true)"
        [ -n "$file" ] || fail "the app exited with no log (Console.app says why)"
      fi
    fi
  done
  local copy="$out/$mode-$(basename "$file")"
  copy_measure_file "$file" "$copy" >/dev/null
  case "$file" in
    *.failed) fail "the app logged nothing: $(cat "$copy")" ;;
  esac
  echo "$copy"
}

# $1 the mode (iphone, ipad), $2 the device kind devicectl names (iPhone,
# iPad), $3 the ref, then the options.
phone() {
  local mode="$1" kind="$2" ref="$3"
  shift 3
  local passes frames timings
  options "$@"
  [ -n "${VP_DEVELOPMENT_TEAM:-}" ] || fail "set VP_DEVELOPMENT_TEAM (README.md, iOS)"
  local sha worktree app stamp device name out
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  if [ "$dry" = 1 ]; then
    sha="$ref"
  else
    sha="$(commit_of "$MAC_REPO" "$ref")" || fail "no commit $ref in $MAC_REPO"
  fi
  worktree="$MAC_REPO/.worktrees/measure-run"
  if [ -e "$worktree" ]; then
    run git -C "$worktree" checkout --quiet --detach "$sha"
  else
    run git -C "$MAC_REPO" worktree add --quiet --detach "$worktree" "$sha"
  fi
  run env MoltenVK_ROOT="$MoltenVK_ROOT" cmake -S "$worktree" --preset ios \
    -DVP_DEVELOPMENT_TEAM="$VP_DEVELOPMENT_TEAM" -DVP_BUNDLE_ID="$VP_BUNDLE_ID"
  run cmake --build "$worktree/build-ios" --config Release \
    --target volumetric_kit_player -- -allowProvisioningUpdates
  app="$worktree/build-ios/apps/ios/Release-iphoneos/volumetric_kit_player.app"
  device="$(pick_device "$kind")"
  run xcrun devicectl device install app --device "$device" "$app"
  name="$(basename "$MAC_STREAM")"
  out="$MEASURE_OUT/$(date +%Y-%m-%d)"
  run mkdir -p "$out"
  if [ "$dry" = 1 ]; then
    run xcrun devicectl device copy to --device "$device" \
      --domain-type appDataContainer --domain-identifier "$VP_BUNDLE_ID" \
      --source "$MAC_STREAM" --destination "Documents/$name"
    local timing
    for timing in $(echo "$timings" | tr , ' '); do
      run xcrun devicectl device process launch --device "$device" \
        --terminate-existing "$VP_BUNDLE_ID" -- --measure "$name" \
        --passes "$passes" ${frames:+--frames "$frames"} --timing "$timing"
      echo "+ (every 5 s, up to 20 min: list Documents/measure until a new" \
        ".csv or .failed, or the app is gone; copy it into $out/)"
    done
    return
  fi
  # Globals, for the helpers and the trap.
  listing="$(mktemp)"
  tmp_before="$(mktemp)"
  tmp_now="$(mktemp)"
  trap 'rm -f "$listing" "$tmp_before" "$tmp_now"' EXIT
  if ! devicectl_json "$listing" device info files --device "$device" \
    --domain-type appDataContainer --domain-identifier "$VP_BUNDLE_ID" \
    --subdirectory Documents ||
    [ -z "$(json_strings "$listing" "$name")" ]; then
    xcrun devicectl device copy to --device "$device" \
      --domain-type appDataContainer --domain-identifier "$VP_BUNDLE_ID" \
      --source "$MAC_STREAM" --destination "Documents/$name"
  fi
  local fetched=() timing copy
  for timing in $(echo "$timings" | tr , ' '); do
    copy="$(launch "$timing")"
    fetched+=("$copy")
  done
  summarize "${fetched[@]}" | tee "$out/$stamp-${sha:0:7}-$mode.md"
}

[ "$#" -ge 1 ] || usage
if [ "$1" = --dry-run ]; then
  dry=1
  shift
fi
[ "$#" -ge 1 ] || usage
mode="$1"
shift
case "$mode" in
  lab) [ "$#" -ge 1 ] || usage; lab "$@" ;;
  iphone) [ "$#" -ge 1 ] || usage; phone iphone iPhone "$@" ;;
  ipad) [ "$#" -ge 1 ] || usage; phone ipad iPad "$@" ;;
  summarize) summarize "$@" ;;
  *) usage ;;
esac
